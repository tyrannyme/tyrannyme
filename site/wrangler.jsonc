{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tyranny-site",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "tyranny.me", "custom_domain": true },
    { "pattern": "www.tyranny.me", "custom_domain": true }
  ],
  "workers_dev": false
}
